APP_NAME=StudyFlow
APP_ENV=development
DEBUG=True
API_V1_PREFIX=/api/v1
# In production on Render/Supabase, set DATABASE_URL=postgresql+psycopg://user:password@host:port/dbname
# In local development without Postgres, leave empty or use sqlite+pysqlite:///./studyflow.db
DATABASE_URL=sqlite:///./studyflow.db
JWT_SECRET_KEY=dev_jwt_secret_studyflow_change_in_production_key_123456789
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440
FRONTEND_ORIGIN=http://localhost:3000
