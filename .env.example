# ==========================================
# StudyFlow Root Environment Variables
# ==========================================

# --- Backend Configuration ---
APP_NAME=StudyFlow
APP_ENV=development
DEBUG=True
API_V1_PREFIX=/api/v1

# In local development without Postgres, defaults to SQLite:
DATABASE_URL=sqlite:///./studyflow.db
# In production on Render/Supabase, set DATABASE_URL=postgresql+psycopg://user:password@host:port/dbname

JWT_SECRET_KEY=change_me_to_a_secure_random_secret_in_production_32_chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440
FRONTEND_ORIGIN=http://localhost:3000

# --- Frontend Configuration ---
# In production on Vercel, set NEXT_PUBLIC_API_URL to your deployed Render FastAPI backend URL (e.g. https://studyflow-api.onrender.com/api/v1)
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
